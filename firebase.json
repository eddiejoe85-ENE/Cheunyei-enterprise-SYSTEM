{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "firestore.rules.full", "README.md", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(html|js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/vendor/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
      { "source": "/models/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
    ]
  }
}
